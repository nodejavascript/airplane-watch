{
  "name": "airplane-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watch a named aircraft leave a named airport, and be told when it does. Static site for airplane-watch.nodejavascript.com",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && node tools/serve.mjs",
    "test": "npm run build && node --test test/detect.test.js test/static.test.js test/rollbar.test.js test/faults.test.js test/secrets.test.js",
    "test:e2e": "npm run build && node --test test/e2e.test.js",
    "test:all": "npm run build && node --test test/*.test.js",
    "test:live": "node tools/live-check.mjs",
    "survey": "node tools/survey-types.mjs",
    "survey:round": "tools/run-survey.sh",
    "db:tunnel": "systemctl --user start aircraft-db-tunnel.service",
    "db:load": "node tools/load-db.mjs",
    "db:check": "node tools/load-db.mjs --check",
    "historic:load": "node tools/load-historic.mjs",
    "historic:check": "node tools/load-historic.mjs --check",
    "icons": "python3 tools/make-icons.py",
    "deploy": "bash tools/deploy.sh"
  },
  "engines": {
    "node": "22"
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
